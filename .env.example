STORZ_URL=https://storz.sistemaescudo.com.br/admin/main.php?elc=<TOKEN_DA_EMPRESA>
STORZ_USER=
STORZ_PASS=

# Caminho para a pasta raiz de inspetores no Drive local/mapeado (usado pelo DriveFileSystemAdapter)
HSE_DRIVE_PATH=D:\Drive\.shortcut-targets-by-id\1ftfSSauhVuaCKimKCKUI1bstr1ALZShq\01 - Inspetores de Qualidade & Técnicos de Operações

# ID da pasta raiz no Drive (usado pelo GoogleDriveOAuthAdapter, alternativa via API).
# Se definido, tem prioridade sobre HSE_DRIVE_PATH — ver driveAdapterFactory.ts.
HSE_DRIVE_FOLDER_ID=1ftfSSauhVuaCKimKCKUI1bstr1ALZShq

# --- Modo local (interativo, com navegador) ---
# Caminho para o JSON de credenciais do OAuth Client (tipo "Desktop app", baixado do Google Cloud Console)
GOOGLE_OAUTH_CREDENTIALS_PATH=scratch/google_oauth_client.json
# Onde o token (refresh token) fica salvo após a primeira autorização — não versionar
GOOGLE_OAUTH_TOKEN_PATH=scratch/google_oauth_token.json

# --- Modo CI (sem navegador, usado pelo GitHub Actions) ---
# Se as 3 estiverem definidas, têm prioridade sobre o modo local acima e não tocam em disco.
# client_id/client_secret vêm do mesmo JSON usado no modo local; refresh_token é extraído de
# scratch/google_oauth_token.json depois de autorizar uma vez localmente.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Data de referência para cálculo de prazos (opcional, formato ISO). Se omitido, usa a data atual.
HSE_REF_DATE=

# Smartsheet — leitura SOMENTE LEITURA da planilha RPO-EHS via API (nunca escreve nada de volta).
# Token em Account > Apps & Integrations > API Access.
SMARTSHEET_API_TOKEN=
SMARTSHEET_RPO_SHEET_ID=

# SMTP para envio real de e-mails de alerta. Se omitido, usa DummyEmailService (grava HTML em scratch/emails/).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
HSE_EMAIL_TO=joao.oliveira@arthwind.com.br
DO_EMAIL_TO=joao.oliveira@arthwind.com.br
