{
  "name": "hse-audition-automation",
  "version": "1.0.0",
  "description": "HSE Audit Automation Hub - Drive, RPO, Storz Playwright & EHS Compliance Engine",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "triangulate": "tsx src/cli/runTriangulation.ts",
    "storz-audit": "tsx src/cli/runStorzAudit.ts",
    "hse-report": "tsx src/cli/runHSEReportExporter.ts",
    "test-gdrive": "tsx src/cli/testGoogleDriveApi.ts",
    "drive-rpo-audit": "tsx src/cli/runDriveRpoAudit.ts",
    "storz-history-report": "tsx src/cli/runStorzHistoryReport.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "googleapis": "^176.0.0",
    "nodemailer": "^6.9.9",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.41.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
}
